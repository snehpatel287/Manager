# MongoDB connection string. Local: mongodb://127.0.0.1:27017/manager
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/manager
MONGODB_URI=mongodb://127.0.0.1:27017/manager

PORT=4000

# Optional shared secret. When set, every /api request must send it in the
# x-api-key header. Set the same value as API_KEY in the Next app's .env.local.
API_KEY=

# Reddit API credentials for the "Check on Reddit" status checker.
# Create a "script" app at https://www.reddit.com/prefs/apps
# (redirect uri can be http://localhost:3000 — it isn't used).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive UA: <platform>:<app id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=web:personal-post-manager:0.1 (by /u/your_username)
